{
  "paused": false,
  "max_agent_runs_per_day": 4,
  "max_runs_on_date": {
    "2026-10-10": 20
  },
  "agents": {
    "localisation": {
      "auto": true,
      "rule": "queue"
    },
    "research": {
      "auto": true,
      "rule": "queue"
    },
    "partners": {
      "auto": true,
      "rule": "queue"
    },
    "designer": {
      "auto": true,
      "rule": "queue"
    },
    "webbuilder": {
      "auto": true,
      "rule": "when_changed",
      "watch": [
        "design",
        "brand",
        "agents/webbuilder/feedback.md"
      ],
      "outputs": [
        "site/style.css",
        "site/templates"
      ]
    },
    "media": {
      "auto": true,
      "rule": "every_days",
      "days": 7,
      "folder": "outreach/media"
    },
    "coordinator": {
      "auto": true,
      "rule": "every_days",
      "days": 7,
      "folder": "docs/status"
    },
    "branding": {
      "auto": false
    },
    "social": {
      "auto": true,
      "rule": "refill",
      "folder": "social/queue",
      "min": 2
    }
  },
  "priority": [
    "coordinator",
    "social",
    "designer",
    "webbuilder",
    "research",
    "localisation",
    "partners",
    "media"
  ]
}
